generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Branch {
  BranchID   String         @id @default(cuid())
  BranchName String
  Users      User[]
  Tickets    RepairTicket[]
}

model User {
  UserID       String          @id @default(uuid())
  Username     String          @unique
  Password     String          @default("1234")
  PasswordHash String?
  Role         String          @default("User")
  BranchID     String
  Branch       Branch          @relation(fields: [BranchID], references: [BranchID])
  Tickets      RepairTicket[]
  Comments     TicketComment[]
  CreatedAt    DateTime        @default(now())
}

model RepairTicket {
  TicketID       String             @id @default(cuid())
  UserID         String
  User           User               @relation(fields: [UserID], references: [UserID], onDelete: NoAction, onUpdate: NoAction)
  BranchID       String
  Branch         Branch             @relation(fields: [BranchID], references: [BranchID], onDelete: NoAction, onUpdate: NoAction)
  Product        String
  Symptom        String
  Description    String?
  ImageURL       String?
  Priority       String             @default("Medium")
  CurrentStatus  String             @default("Open")
  // Phase 2B (12-05-2026): JobCategory MON-11 — admin-editable categorization (separate from
  // free-text Symptom). Predefined list lives in src/lib/jobCategories.ts. NULL for legacy rows.
  // SupplierName MON-12 — populated only when JobCategory == "ช่างรับเหมา" (validated app-side, not DB).
  JobCategory    String?
  SupplierName   String?
  RequestDate    DateTime?
  ActualDate     DateTime?
  SLA_Deadline   DateTime?
  TotalCost      Float?
  CSAT_Score     Int?
  // MON-13 (12-05-2026): Technician retained TEMPORARILY during 2-phase migration.
  // Phase 1 (this push): add TicketTechnician join table alongside legacy field.
  // Phase 2 (after migrate-technicians.mjs verified): drop Technician column.
  // DO NOT remove this field until scripts/migrate-technicians.mjs has been run AND
  // row counts verified — premature removal = silent data loss.
  Technician     String?
  Technicians    TicketTechnician[]
  AdminSignature String?
  UserSignature  String?
  CreatedAt      DateTime           @default(now())
  History        TicketHistory[]
  Comments       TicketComment[]

  @@index([BranchID])
  @@index([CurrentStatus])
  @@index([JobCategory])
  @@index([SupplierName])
}

// MON-13 (12-05-2026): join table replaces RepairTicket.Technician String? (single-assignment).
// Cascade delete keeps assignment rows in sync if a ticket is removed. Unique constraint
// blocks duplicate assignment of same technician to same ticket (idempotent reassign).
model TicketTechnician {
  id             String       @id @default(cuid())
  TicketID       String
  Ticket         RepairTicket @relation(fields: [TicketID], references: [TicketID], onDelete: Cascade)
  TechnicianName String
  AssignedAt     DateTime     @default(now())

  @@unique([TicketID, TechnicianName])
  @@index([TicketID])
  @@index([TechnicianName])
}

model TicketHistory {
  HistoryID String       @id @default(cuid())
  TicketID  String
  Ticket    RepairTicket @relation(fields: [TicketID], references: [TicketID])
  Status    String
  UpdatedBy String
  Note      String?
  Timestamp DateTime     @default(now())
}

model TicketComment {
  CommentID String       @id @default(cuid())
  TicketID  String
  Ticket    RepairTicket @relation(fields: [TicketID], references: [TicketID], onDelete: NoAction, onUpdate: NoAction)
  UserID    String
  User      User         @relation(fields: [UserID], references: [UserID], onDelete: NoAction, onUpdate: NoAction)
  Message   String
  ImageURL  String?
  Timestamp DateTime     @default(now())
}

model Notification {
  NotifID    String   @id @default(cuid())
  TargetRole String? // 'Admin' or 'Branch'
  TargetUser String? // Specific BranchID
  Title      String
  Message    String
  TicketID   String?
  IsRead     Boolean  @default(false)
  CreatedAt  DateTime @default(now())
}

// ────────────────────────────────────────────────────────────────────────────
// Phase 2A — Security Hardening (MON-10)
// Append-only event/state stores for admin accountability and brute-force
// protection. NO FOREIGN KEYS to User: (1) AuditLog must survive user
// deletion to preserve the audit trail, (2) FailedLoginAttempt.Username
// may refer to a non-existent account (attempts are recorded before
// authentication resolves), (3) the User model is in flux pending the
// Phase 2D Password column drop. String refs only.
// ────────────────────────────────────────────────────────────────────────────

model AuditLog {
  LogID      String   @id @default(cuid())
  UserID     String? // who performed the action (nullable for system-originated events)
  Action     String // e.g. "ticket.status.update", "ticket.technician.assign", "user.role.change"
  EntityType String? // e.g. "RepairTicket", "User"
  EntityID   String? // e.g. ticketId, userId — the row that was acted upon
  Before     String? // JSON snapshot before mutation (nullable for create actions)
  After      String? // JSON snapshot after mutation (nullable for delete actions)
  IPAddress  String? // best-effort, captured from request headers when available
  UserAgent  String? // best-effort, captured from request headers when available
  Timestamp  DateTime @default(now())

  @@index([UserID])
  @@index([Action])
  @@index([EntityType, EntityID])
  @@index([Timestamp])
}

model FailedLoginAttempt {
  AttemptID   String   @id @default(cuid())
  Username    String // username tried (case-preserved; may not match any existing User row)
  IPAddress   String? // best-effort, captured from request headers when available
  AttemptedAt DateTime @default(now())

  @@index([Username, AttemptedAt]) // composite — hottest read path for windowed-count rate-limit queries
}
