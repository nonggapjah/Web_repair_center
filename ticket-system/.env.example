# Web Repair Center — Environment Variables Template
# Copy this file to .env (or .env.local) and fill in actual values.
# .env / .env.local are gitignored. .env.example is committed as the template.

# ----- Database (Supabase Postgres) -----
# Pooled connection used at runtime by the app
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection used by Prisma migrate / introspect
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-<region>.pooler.supabase.com:5432/postgres"

# ----- Supabase Storage Configuration -----
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<supabase-anon-jwt>"

# ----- Admin Initial Password (used by seed_production.mjs ONLY) -----
# Strong password (min 12 chars). seed_production.mjs hashes this with bcrypt
# before writing to DB. Leave UNSET in production after initial seed — rotate
# the actual admin password by direct DB update or future admin UI.
# ADMIN_INITIAL_PASSWORD="<replace-with-strong-12+chars-password>"

# ----- Login Rate Limit (SYN-08, Phase 2A) -----
# Brute-force protection thresholds. Defaults shown — uncomment to override.
# MAX_ATTEMPTS failures within WINDOW_MIN minutes trip a LOCKOUT_MIN-minute lockout
# (measured from the most recent attempt). Per-Username (not per-IP — IP-block is
# Phase 2B). Cleared on successful login.
# RATE_LIMIT_MAX_ATTEMPTS=10
# RATE_LIMIT_WINDOW_MIN=15
# RATE_LIMIT_LOCKOUT_MIN=15

# ----- Session Timeout (SYN-09, Phase 2A) -----
# Role-based session cookie max-age in seconds. Defaults shown — uncomment to override.
# Admin: 4 hours (shortest — highest privilege)
# Technician: 8 hours (standard work shift)
# User (branch): 24 hours (longest — preserves prior UX, branch flows may pause)
# SESSION_TIMEOUT_ADMIN_SEC=14400
# SESSION_TIMEOUT_TECHNICIAN_SEC=28800
# SESSION_TIMEOUT_USER_SEC=86400

# ----- Notes -----
# - Prisma reads DATABASE_URL/DIRECT_URL automatically when running prisma commands
# - NEXT_PUBLIC_* variables are exposed to the browser — never put secrets here
